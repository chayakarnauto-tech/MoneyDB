{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Income or expense transaction record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string", "maxLength": 200 },
        "paymentMethod": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "type", "amount", "category", "date"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Monthly spending budget target",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "monthlyLimit": { "type": "number" }
      },
      "required": ["userId", "month", "monthlyLimit"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User document storing basic user profile"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Individual income and expense items owned by a user"
    },
    "/budgets/{budgetId}": {
      "schema": "Budget",
      "description": "Monthly budget targets per user"
    }
  }
}
